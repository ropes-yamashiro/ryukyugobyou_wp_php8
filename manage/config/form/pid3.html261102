      //       }
      //     }
      //   });
      // });

      $(function () {
        $('#kengaku_day').datepicker({
          dateFormat: 'yy/mm/dd(D)',
          beforeShowDay: function (date) {
            var today = new Date();
            today.setHours(0, 0, 0, 0); // 時間部分をリセットして日付のみを比較

            var isToday = date.getTime() === today.getTime();
            var isApril2023 = date.getFullYear() === 2023 && date.getMonth() === 3;
            var isMay3rd2023 = date.getFullYear() === 2023 && date.getMonth() === 4 && date.getDate() === 3;
            var isWeekend = date.getDay() === 6 || date.getDay() === 0;
            var isWednesday = date.getDay() === 3;

            if (isToday) {
              // 当日は選択不可
              return [false, 'ui-state-disabled'];
            }

            if (isApril2023) {
              if (isWednesday) {
                // 2023年4月の水曜日は選択可能
                return [true, ''];
              } else if (isWeekend) {
                // 2023年4月の土曜日と日曜日は選択不可
                return [false, 'ui-state-disabled'];
              } else {
                // 2023年4月の他の日は選択可能
                return [true, ''];
              }
            } else {
              if (isMay3rd2023) {
                // 2023年5月3日の水曜日は選択可能
                return [true, ''];
              } else if (isWednesday) {
                // 通年の水曜日は選択不可
                return [false, 'ui-state-disabled'];
              } else {
                // 他の日は選択可能
                return [true, ''];
              }
            }
          }
        });
      });

