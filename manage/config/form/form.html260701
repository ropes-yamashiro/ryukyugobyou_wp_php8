  <script>
    (function () {
      const TARGET_PARAM = 'seimeinooka-jyumokusou';
      const PENDING_KEY = TARGET_PARAM + '_pending';

      window.getSeimeinookaState = function () {
        if (window.__seimeinookaState) {
          return window.__seimeinookaState;
        }

        const urlParams = new URLSearchParams(window.location.search);
        const urlHasParam = urlParams.has(TARGET_PARAM);
        const pending = sessionStorage.getItem(PENDING_KEY) === '1';
        const active = urlHasParam || pending;

        // バリデーションエラー後の再描画を1回橋渡ししたら pending は消す
        if (!urlHasParam && pending) {
          sessionStorage.removeItem(PENDING_KEY);
        }

        window.__seimeinookaState = {
          targetParam: TARGET_PARAM,
          pendingKey: PENDING_KEY,
          urlHasParam: urlHasParam,
          active: active
        };

        return window.__seimeinookaState;
      };

      window.isSeimeinookaMode = function () {
        return window.getSeimeinookaState().active;
      };

      window.markSeimeinookaPending = function () {
        if (window.isSeimeinookaMode()) {
          sessionStorage.setItem(PENDING_KEY, '1');
        }
      };

      window.applySeimeinookaParamToForms = function () {
        if (!window.isSeimeinookaMode()) return;

        const forms = document.getElementsByTagName('form');

        for (let i = 0; i < forms.length; i++) {
          const form = forms[i];
          const actionAttr = form.getAttribute('action');
          const isAbsolute = !!actionAttr && /^(https?:)?\/\//.test(actionAttr);
          const url = actionAttr ? new URL(actionAttr, window.location.origin) : new URL(window.location.href);

          if (!url.searchParams.has(TARGET_PARAM)) {
            const query = url.search ? url.search.replace(/^\?/, '') + '&' : '';
            url.search = query + encodeURIComponent(TARGET_PARAM);
          }

          form.setAttribute('action', isAbsolute ? url.toString() : url.pathname + url.search + url.hash);

          let hidden = form.querySelector('input[name="' + TARGET_PARAM + '"]');
          if (!hidden) {
            hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = TARGET_PARAM;
            form.appendChild(hidden);
          }
          hidden.value = '1';

          if (!form.dataset.seimeinookaBound) {
            form.addEventListener('submit', window.markSeimeinookaPending);
            form.dataset.seimeinookaBound = '1';
          }
        }
      };

      document.addEventListener('DOMContentLoaded', function () {
        window.applySeimeinookaParamToForms();

        const btnNext = document.getElementById('btnNext');
        if (btnNext && window.isSeimeinookaMode()) {
          btnNext.addEventListener('click', window.markSeimeinookaPending);
        }
      });
    })();
  </script>

  {javatag}
