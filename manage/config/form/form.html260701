            if (window.isSeimeinookaMode()) {
              breadcrumbArea.innerHTML = '';
            } else {
              breadcrumbArea.innerHTML = `
                <div class="breadcrumbs" typeof="BreadcrumbList" vocab="https://schema.org/">
                  <span property="itemListElement" typeof="ListItem">
                    <a property="item" typeof="WebPage" title="Go to 琉球御廟." href="https://ryukyugobyou.okinawa" class="home">
                      <span property="name">トップページ</span>
                    </a>
                    <meta property="position" content="1">
                  </span> &gt; 
                  <span property="itemListElement" typeof="ListItem">
                    <span property="name" class="post post-page current-item">資料請求</span>
                    <meta property="url" content="https://ryukyugobyou.okinawa/form.php">
                    <meta property="position" content="2">
                  </span>
                </div>
              `;
            }
          });
        </script>
        <!-- /パンくずリスト -->

        <div class="entry-content">
          <div class="entry-header">
            <h1 class="entry-title">資料請求</h1>
          </div>

          <div class="bg-light-blue">
            <section class="lead">
              <p id="lead-text">琉球御廟にご興味をお持ちの方は、下記フォームに必要事項をご入力の上、ご送信ください。琉球御廟の資料をお送りします。</p>
            </section>
            <script>
              document.addEventListener('DOMContentLoaded', function () {
                const leadArea = document.getElementById('lead-text');

                if (leadArea && window.isSeimeinookaMode()) {
                  leadArea.textContent = '下記フォームに必要事項をご入力の上、ご送信ください。資料をお送りいたします。';
                }
              });
            </script>
          </div>

          <article>
            <!-- ブロック -->
            <section class="container-field cmn_block">
              <!-- インナー -->
              <div class="container container2">
                {errany}
                <form {form}>
                  {hidden}

                  <table class="cmn_table_type04">
                    <tbody>

                      <!-- <tr>
                        <th>お問い合わせ施設<span class="hisu">必須</span></th>
                        <td>
                          <ul>
                            <li class="li_01"><label class="in_check checkbox-red in_check-care"><input type="checkbox"
                                  name="checkbox_facility[]" id="checkbox_facility" value="永代供養・室内墓所 琉球御廟"
                                  {checkbox_facility_永代供養・室内墓所 琉球御廟} /><span>永代供養・室内墓所 琉球御廟</span></label></li>
                            <li class="li_01"><label class="in_check checkbox-red in_check-care"><input type="checkbox"
                                  name="checkbox_facility[]" id="checkbox_facility" value="樹木葬墓地 結花"
                                  {checkbox_facility_樹木葬墓地 結花} /><span>樹木葬墓地 結花</span></label></li>
                          </ul>
                          {errcheckbox_facility}
                        </td>
                      </tr> -->

                      <tr>
                        <th>お名前（全角）<span class="hisu">必須</span></th>
                        <td>
                          <p>姓：<input name="name-sei" type="text" class="middle3" id="name-sei"
                              value="{name-sei}" />名：<input name="name-mei" type="text" class="middle3" id="name-mei"
                              value="{name-mei}" /><br /><em class="exam">例） 山田太郎</em></p>{errname-sei} {errname-mei}
                        </td>
                      </tr>

                      <tr>
                        <th>お名前（ふりがな）<span class="hisu">必須</span></th>
                        <td>
                          <p>
                            姓：<input name="kana-sei" type="text" class="middle3" id="kana-sei"
                              value="{kana-sei}" />名：<input name="kana-mei" type="text" class="middle3" id="kana-mei"
                              value="{kana-mei}" /><br /><em class="exam">例） やまだたろう</em></p>{errkana-sei} {errkana-mei}
                        </td>
                      </tr>

                      <tr>
                        <th>郵便番号 <span class="hisu">必須</span></th>
                        <td>
                          <p class="zip_wrap"><input name="zip" type="text" class="small" id="zip" value="{zip}"
                              maxlength="8" />
                            <button type="button" class="zipcloud_search"
                              onclick="AjaxZip3.zip2addr('zip','','pref','address1','address2');">郵便番号から<span
                                class="zipbtn">住所を検索</span></button>
                            <em class="exam yu">例） 123-4567 （半角数字で）</em>
                          </p>{errzip}
                        </td>
                      </tr>

                      <tr>
                        <th>都道府県 <span class="hisu">必須</span></th>
                        <td>
                          <p><label><select name="pref" id="pref">{pref}</select></label></p>{errpref}
                        </td>
                      </tr>

                      <tr>
                        <th>市区郡 <span class="hisu">必須</span></th>
                        <td>
                          <p><label><input name="address1" type="text" class="address" id="address1" value="{address1}"
                                maxlength="122" /></label>
                            <em class="exam">例）那覇市</em>
                          </p>{erraddress1}
                        </td>
                      </tr>

                      <tr>
                        <th>町名・番地 <span class="hisu">必須</span></th>
                        <td>
                          <p><label><input name="address2" type="text" class="address" id="address2" value="{address2}"
                                maxlength="122" /></label>
                            <em class="exam">例）真地２</em>
                          </p>{erraddress2}
                        </td>
                      </tr>

                      <tr>
                        <th>ビル・マンション名</th>
                        <td>
                          <p><label><input name="place" type="text" class="place" id="place" value="{place}"
                                maxlength="122" /></label><em class="exam">例）○○マンション　101号室</em></p>{errplace}
                        </td>
                      </tr>

                      <tr>
                        <th>お電話番号<span class="hisu">必須</span></th>
                        <td>
                          <p><input name="tel" type="text" class="tel" id="tel" value="{tel}" /><em class="exam">例）
                              098-765-4321 （市外局番から）</em></p>{errtel}
                        </td>
                      </tr>

                      <tr>
                        <th>Eメール<span class="hisu">必須</span></th>
                        <td>
                          <p><input name="mail" type="text" class="address" id="Mail" value="{mail}" /><em
                              class="exam">info@abcd.com（半角英数で）</em></p>
                          {errmail}
                          <em class="exam">携帯メールアドレスをご入力の場合、携帯の設定により返信メールが届かないことがございます。</em>
                        </td>
                      </tr>

                      <tr>
                        <th>検討理由</th>
                        <td>
                          <ul>
                            <li class="li_01"><label class="in_check checkbox-red in_check-care"><input type="checkbox"
                                  name="checkbox_examination[]" id="checkbox_examination" value="ご納骨(ご遺骨所持)"
                                  {checkbox_examination_ご納骨(ご遺骨所持)} /><span>ご納骨(ご遺骨所持)</span></label></li>
                            <li class="li_01"><label class="in_check checkbox-red in_check-care"><input type="checkbox"
                                  name="checkbox_examination[]" id="checkbox_examination" value="ご生前(終活)"
                                  {checkbox_examination_ご生前(終活)} /><span>ご生前(終活)</span></label></li>
                            <li class="li_01"><label class="in_check checkbox-red in_check-care"><input type="checkbox"
                                  name="checkbox_examination[]" id="checkbox_examination" value="墓じまい(改葬)"
                                  {checkbox_examination_墓じまい(改葬)} /><span>墓じまい(改葬)</span></label></li>
                            <li class="li_01"><label class="in_check checkbox-red in_check-care"><input type="checkbox"
                                  name="checkbox_examination[]" id="checkbox_examination" value="その他"
                                  {checkbox_examination_その他} /><span>その他</span></label></li>
                          </ul>
                        </td>
                      </tr>

                      <tr>
                        <th>ご質問・お問い合わせ内容</th>
                        <td>
                          <p><em class="exam">ご質問等ございましたら、ご自由にお書きください。</em></p>
                          <p><textarea name="question" class="word" rows="3" id="question"
                              style="height: 150px;">{question}</textarea></p>
                        </td>
                      </tr>
                  </table>

                  <table class="cmn_table_type04">
                    <tr>
                      <th>琉球御廟を知ったきっかけ（複数選択化）</th>
                      <td>
                        <ul class="clearfix">
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="検索サイト"
                                {questionnaire_検索サイト}>検索サイト</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="インターネット広告"
                                {questionnaire_インターネット広告}>インターネット広告</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="TV・CM"
                                {questionnaire_TV・CM}>TV・CM</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="ラジオCM"
                                {questionnaire_ラジオCM}>ラジオCM</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="新聞広告"
                                {questionnaire_新聞広告}>新聞広告</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="タウン誌広告"
                                {questionnaire_タウン誌広告}>タウン誌広告</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="看板・ポスター"
                                {questionnaire_看板・ポスター}>看板・ポスター</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="折込チラシ"
                                {questionnaire_折込チラシ}>折込チラシ</span></li>
                          <li class="li_01"><span>
                              <input type="checkbox" name="questionnaire[]" id="questionnaire" value="その他"
                                {questionnaire_その他}>その他</span></li>
                        </ul>
                      </td>
                    </tr>
                  </table>

                  <div class="btn_wrp">
                    <div class="rc-anchor" style="display:none;">
                      <table class="table table-borderd">
                        <tr>
                          <td class="rc-anchor-checkbox">
                            <input type="checkbox" id="checkToken" class="rc-token-checkbox" value="1">
                          </td>
                          <td class="rc-anchor-label">
                            <label class="rc-token-checkbox-label" aria-hidden="true" role="presentation">
                              私はロボットではありません
                            </label>
                          </td>
                          </td>
                        </tr>
                      </table>
                    </div>

                    <label>
                      <input type="submit" id="btnNext" name="next" onclick="return selector('next');" value="確認画面へ"
                        onkeypress="n" class="btn" style="visibility:visible;">
                    </label>
                  </div>
                </form>
              </div>
              <!-- インナー -->
            </section>
            <!-- ブロック -->
          </article>
        </div>
    </main>
