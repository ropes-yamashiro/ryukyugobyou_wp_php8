    }


</style>
<!--[if IE]>
<link href="css/ie.css" media="screen" rel="stylesheet" type="text/css"/>
<![endif]-->
<form method="POST" name="formx" enctype="multipart/form-data" id="formx" action="">
    <input type="hidden" name="cmd" id="cmd" />
    <input type="hidden" name="typex" id="typex" value="group_list" />
    <input type="hidden" name="pageno" id="pageno" value="{pageno}"/>
    <input type="hidden" name="targetid" id="targetid" />
    <input type="hidden" name="move_size" id="move_size" />
    <input type="hidden" name="move_type" id="move_type" />
    <table border="0" cellpadding="0" cellspacing="0" class="theader thcommand">
        <tr>
            <td class="tlefts"><div style="float:left;">グループ一覧：
                <input type="button" value="新規" onclick="return new_group()" />
                　表示件数：<select name="count" onchange="return ch_state();">{html_count}</select>

                </div>
                 <div style="float:right;margin: 3px;" >
                 {html_paging}
                 
                 
                 </div>
            </td>
        </tr>
    </table>

    {html_err}

    <table width="590px" cellpadding="0" cellspacing="0" class="tlist">
        <tr id="tableheader">
            <th width="150px">グループ名aaaaaaaaaaaaaaaaaaaa</th>
            <th>コメント</th>
            <th width="120px">順位変更</th>
            <th width="50px">削除</th>
        </tr>

        {out_list}
        



        

        
    </table>

</form>";}