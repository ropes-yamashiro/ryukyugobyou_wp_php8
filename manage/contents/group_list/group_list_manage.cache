<script language="javascript" src="jscript/jquery.js"></script>
<script language="javascript" src="jscript/editor/ckeditor.js"></script>
<script TYPE="text/javascript">
    <!--

    //新規データを作成する
    function detail_group(id){
        document.formx.action = "admin.php?typex=group_detail&id=" + id;
        document.formx.typex.value = "group_detail";
        document.formx.cmd.value = "view";
        document.formx.submit();
        return false;
    }

    //ページを切り替える
    function ch_page(no){
        $("#cmd").val("view");
        $("#pageno").val(no);
        document.formx.submit();
        return false;
    }

    //新規データを作成する
    function new_group(){
        document.formx.action = "admin.php?typex=group_detail";
        document.formx.typex.value = "group_detail";
        document.formx.cmd.value = "view";
        document.formx.submit();
        return false;
    }

    //グループを変更する
    function ch_state(){
        document.formx.pageno.value = 1;
        document.formx.cmd.value="view";
        document.formx.submit();
        return false;
    }


    //表示の切換え
    function removeall(id,title){
        if(window.confirm(title + "を削除しますか？")){
            document.formx.cmd.value = "removeall";
            document.formx.targetid.value = id;
            document.formx.submit();
        }
        return false;
    }


    //色付け
    function chBG2(obj, color){
        var bgcolors = new Array("", "#FFDDDD");
        $("tr[name='" + obj + "']").css('background-color',bgcolors[color]);
    }

    //==========================================================================

    //位置を移動させる
    function moveitem(target,size,updown){
        $("#move_size").val(size);
        $("#move_type").val(updown);
        $("#targetid").val(target)
        $("#cmd").val("rotate");
        document.formx.submit();
        return false;
    }

    // -->
</script>

<style type="text/css">
    .thcommand{
        margin:0 0 15px 0;
    }
    .theader{
        width:100%;
        border: none;
    }
    th.start{
        padding-left:3px;
    }
    .selheader{
        text-decoration: underline;
        font-size:11px;
    }
    .selheader:link{
        text-decoration: none;
        color:#3366cc;
    }
    .selheader:hover{
        color:red;
    }

    .theader .tlefts{
        padding-left: 10px;
    }

    .tinput2{
        width:100%;
        margin:0 0 15px 0;
    }

    .tinput2 {
        border-collapse: separate;
        border-spacing: 0px;
        font-size: x-small;
        line-height: 150%;
    }

    .tinput2 .thlabel {
        width: 80px;
        padding: 5px 10px 5px 10px;
        border-right: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
        text-align: right;
        font-weight: normal;
        background-color: #DDDDDD;
    }

    .tinput2 .tlefts {
        padding: 5px 8px 5px 10px;
        border-right: 1px solid #ccc;
        border-bottom: 1px solid #ccc;
        background-color: #EEEEEE;
    }
    .errmes{
        margin-bottom: 15px;
    }

   /* 上ボタン
    ---------------------------------------------------------------------------*/

    a.btnup1{
        display: inline;
        float: left;
        width: 26px; height: 26px;
        margin-left: 8px;
        background: url(image/btn/up1.gif) no-repeat top left;
        text-indent: -10000px;
    }

    a.btnup1:hover{
        background-position: right top;
    }

     a.btnup10{
        display: inline;
        float: left;
        width: 26px; height: 26px;
        background: url(image/btn/up10.gif) no-repeat top left;
        text-indent: -10000px;
    }
    a.btnup10:hover{
        background-position: right top;
    }

    a.btnupmax{
        display: inline;
        float: left;
        width: 26px; height: 26px;
        background: url(image/btn/upmax.gif) no-repeat top left;
        text-indent: -10000px;
    }
    a.btnupmax:hover{
        background-position: right top;
    }


    /* 下ボタン
    ---------------------------------------------------------------------------*/

    a.btndn1{
        display: inline;
        float: left;
        width: 26px; height: 26px;
        background: url(image/btn/dn1.gif) no-repeat top left;
        text-indent: -10000px;
    }

    a.btndn1:hover{
        background-position: right top;
    }

     a.btndn10{
        display: inline;
        float: left;
        width: 26px; height: 26px;
        background: url(image/btn/dn10.gif) no-repeat top left;
        text-indent: -10000px;
    }
