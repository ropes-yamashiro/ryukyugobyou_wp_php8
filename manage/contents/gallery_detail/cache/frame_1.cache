";s:11:"list_normal";s:1769:"
<li>
<dl>
<dt><a href="javascript:void(0);" target="_top" onclick="return popup('{popup_id}','{view_id}','{popup_width}','{popup_height}','{gfix}')" >
<img src="{img_mini_path}" alt="{img_title}" width="{thumb_width}" /></a></dt>
<dd class="tittle">{img_comment1}</dd>
<dd>{img_comment2}<br />
{line_class} = 行ごとに設定するクラス method01,method02,... と追加される
<br />
列データ<br />
{thumb_width} = サムネイルの最大横幅<br />
{thumb_height} = サムネイルの最大縦幅<br />

ギャラリーのデータ<br />
{img_mini_path} = サムネイルのイメージのパス<br />
{img_big_path} = イメージのパス<br />
{img_width} = イメージの横幅<br />
{img_height} =　イメージの縦幅<br />
{img_title} =　イメージのタイトル<br />
{img_comment1} = イメージのコメント1<br />
{img_comment2} = イメージのコメント2<br />
{img_link} = リンク先URL<br />
<br />
その他のデータ<br />
{today_year} =　今日の年<br />
{today_mon} =　今日の月<br />
{today_mday} = 今日の日<br />
{today_week} = 曜日<br />
<br />
{final_year} =　最終更新日の年<br />
{final_mon} =　最終更新日の月<br />
{final_mday} = 最終更新日の日<br />
{final_week} = 最終更新日の曜日<br />
<br />
{view_id} = 表示ID<br />
{view_title} = 表示位置のタイトル<br />
{view_comment} = 表示位置のコメント<br />
<br />

{popup_width} = ポップアップウインドウの横幅<br />
{popup_height} = ポップアップウインドウの縦幅<br />
{popup_url} = ポップアップのURL<br />
{popup_id} =　表示する内容のID<br />

{group_comment} = グループのコメント<br />
{group_title} = グループのタイトル
</dd>
</dl>
</li>
